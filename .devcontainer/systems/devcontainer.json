{
  "name": "StudyLings systems (Unixlings / Netlings)",
  "build": { "dockerfile": "Dockerfile" },
  // strace/gdb need ptrace; netns/tc/raw sockets need NET_ADMIN/NET_RAW;
  // io_uring is blocked by Docker's default seccomp profile; bpftrace/XDP need a privileged container.
  "runArgs": [
    "--cap-add=SYS_PTRACE", "--cap-add=NET_ADMIN", "--cap-add=NET_RAW",
    "--security-opt", "seccomp=unconfined"
    // For N10 eBPF/XDP and N11/N12 real NIC chapters use "--privileged" and "--network=host" instead.
  ],
  "postCreateCommand": "pip install --break-system-packages -e . && cd Unixlings && cmake --preset dev && cd ../Netlings && cmake --preset dev",
  "customizations": {
    "vscode": {
      "extensions": ["llvm-vs-code-extensions.vscode-clangd", "ms-vscode.cmake-tools", "ms-python.python"],
      "settings": { "clangd.arguments": ["--compile-commands-dir=build/dev"] }
    }
  }
}
